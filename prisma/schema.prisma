generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (Auth.js managed) ───────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Core User ────────────────────────────────────────────────────────────────

model User {
  id                  String               @id @default(cuid())
  clerkId             String?              @unique @map("clerk_id")
  name                String?
  email               String?              @unique
  emailVerified       DateTime?            @map("email_verified")
  image               String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  accounts            Account[]
  sessions            Session[]
  preferences         UserPreferences?
  mealPlans           MealPlan[]
  orders              Order[]
  feedbackItems       RecipeFeedback[]
  servingAdjustments  ServingAdjustment[]
  substituteDecisions SubstituteDecision[]
  pantryItems         PantryItem[]
  staples             UserStaple[]
  bugReports          BugReport[]
  subscription        Subscription?

  @@map("users")
}

// ─── User Preferences (one-to-one with User) ─────────────────────────────────

model UserPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  preferredStore      String   @default("woolworths") @map("preferred_store")
  suburb              String   @default("")
  postcode            String   @default("")
  dietaryRequirements String[] @default([]) @map("dietary_requirements")
  cuisinePreferences  String[] @default([]) @map("cuisine_preferences")
  proteinPreferences  String[] @default([]) @map("protein_preferences")
  householdSize       Int      @default(2) @map("household_size")
  defaultServings     Int      @default(2) @map("default_servings")
  budgetRange         String   @default("150-250") @map("budget_range")
  cookTimePreference  String   @default("20-40") @map("cook_time_preference")
  includeLunches      Boolean  @default(false) @map("include_lunches")
  includeSnacks       Boolean  @default(true) @map("include_snacks")
  calorieGoal         Int?     @map("calorie_goal")
  macroProteinPct     Int?     @map("macro_protein_pct")
  macroCarbsPct       Int?     @map("macro_carbs_pct")
  macroFatPct         Int?     @map("macro_fat_pct")
  theme               String   @default("system")
  isOnboarded         Boolean  @default(false) @map("is_onboarded")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── Recipe Library ───────────────────────────────────────────────────────────

model Recipe {
  id              String   @id
  name            String
  description     String   @db.Text
  cuisine         String
  primaryProtein  String?  @map("primary_protein")
  servings        Int
  cookTimeMinutes Int      @map("cook_time_minutes")
  prepTimeMinutes Int      @map("prep_time_minutes")
  difficulty      String
  ingredients     Json
  method          String[]
  tags            String[]
  imageQuery      String   @map("image_query")
  estimatedCost   Float?   @map("estimated_cost")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  plannedMeals PlannedMeal[]
  feedback     RecipeFeedback[]

  @@index([cuisine])
  @@index([primaryProtein])
  @@index([isActive])
  @@map("recipes")
}

// ─── Meal Plans ───────────────────────────────────────────────────────────────

model MealPlan {
  id                 String         @id @default(cuid())
  userId             String         @map("user_id")
  generatedAt        DateTime       @default(now()) @map("generated_at")
  preferenceSnapshot Json           @map("preference_snapshot")
  isActive           Boolean        @default(true) @map("is_active")
  createdAt          DateTime       @default(now()) @map("created_at")
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedMeals       PlannedMeal[]
  snacks             PlannedSnack[]
  carts              Cart[]

  @@index([userId, isActive])
  @@index([userId, generatedAt])
  @@map("meal_plans")
}

model PlannedMeal {
  id         String   @id @default(cuid())
  mealPlanId String   @map("meal_plan_id")
  recipeId   String   @map("recipe_id")
  dayIndex   Int      @map("day_index")
  mealType   String   @map("meal_type")
  servings   Int
  feedback   String?
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe     Recipe   @relation(fields: [recipeId], references: [id])

  @@index([mealPlanId])
  @@map("planned_meals")
}

model PlannedSnack {
  id            String   @id @default(cuid())
  mealPlanId    String   @map("meal_plan_id")
  name          String
  description   String
  quantity      Float
  unit          String
  estimatedCost Float    @map("estimated_cost")
  mealPlan      MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@index([mealPlanId])
  @@map("planned_snacks")
}

// ─── Feedback & Learning ──────────────────────────────────────────────────────

model RecipeFeedback {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  recipeId       String   @map("recipe_id")
  recipeName     String   @map("recipe_name")
  feedback       String
  cuisineType    String?  @map("cuisine_type")
  primaryProtein String?  @map("primary_protein")
  timestamp      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe         Recipe   @relation(fields: [recipeId], references: [id])

  @@unique([userId, recipeId])
  @@index([userId, feedback])
  @@index([userId, timestamp])
  @@map("recipe_feedback")
}

model ServingAdjustment {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  recipeId         String   @map("recipe_id")
  originalServings Int      @map("original_servings")
  adjustedServings Int      @map("adjusted_servings")
  timestamp        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("serving_adjustments")
}

model SubstituteDecision {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  accepted  Boolean
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("substitute_decisions")
}

// ─── Product Catalogue ────────────────────────────────────────────────────────

model Product {
  id            String         @id
  retailer      String
  name          String
  brand         String?
  category      String
  price         Float
  unit          String
  unitSize      Float          @map("unit_size")
  unitOfMeasure String         @map("unit_of_measure")
  available     Boolean        @default(true)
  imageUrl      String?        @map("image_url")
  barcode       String?
  lastVerified  DateTime       @default(now()) @map("last_verified")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  priceHistory  PriceHistory[]

  @@index([retailer, category])
  @@index([retailer, available])
  @@map("products")
}

model PriceHistory {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  price      Float
  recordedAt DateTime @default(now()) @map("recorded_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
  @@map("price_history")
}

// ─── Cart & Orders ────────────────────────────────────────────────────────────

model Cart {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  mealPlanId     String?   @map("meal_plan_id")
  retailer       String
  estimatedTotal Float     @map("estimated_total")
  items          Json
  createdAt      DateTime  @default(now()) @map("created_at")
  mealPlan       MealPlan? @relation(fields: [mealPlanId], references: [id])
  order          Order?

  @@index([userId, createdAt])
  @@map("carts")
}

model Order {
  id                      String    @id @default(cuid())
  userId                  String    @map("user_id")
  cartId                  String    @unique @map("cart_id")
  retailer                String
  status                  String    @default("placed")
  estimatedDeliveryDate   String    @map("estimated_delivery_date")
  estimatedDeliveryWindow String    @map("estimated_delivery_window")
  deliveryAddress         String    @map("delivery_address")
  placedAt                DateTime? @map("placed_at")
  confirmationNumber      String?   @map("confirmation_number")
  createdAt               DateTime  @default(now()) @map("created_at")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart                    Cart      @relation(fields: [cartId], references: [id])

  @@index([userId, createdAt])
  @@map("orders")
}

// ─── Pantry ───────────────────────────────────────────────────────────────────

model PantryItem {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  ingredientName String   @map("ingredient_name")
  quantity       Float
  unit           String
  addedAt        DateTime @default(now()) @map("added_at")
  sourceOrderId  String?  @map("source_order_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientName, unit])
  @@index([userId])
  @@map("pantry_items")
}

model UserStaple {
  id             String @id @default(cuid())
  userId         String @map("user_id")
  ingredientName String @map("ingredient_name")
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientName])
  @@index([userId])
  @@map("user_staples")
}

// ─── Subscriptions ───────────────────────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique @map("user_id")
  stripeCustomerId     String    @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripePriceId        String?   @map("stripe_price_id")
  status               String    @default("inactive")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@map("subscriptions")
}

// ─── Internal Testing ─────────────────────────────────────────────────────────

model BugReport {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  url       String
  userAgent String   @map("user_agent") @db.Text
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("bug_reports")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  event      String
  properties Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([userId])
  @@index([createdAt])
  @@map("analytics_events")
}
