# Copy to .env.local for development; set the same keys in Vercel for deploys.
# Integrations marked (optional) are skipped when their keys are unset.

# ─── App ──────────────────────────────────────────────────────────────────────
# Public base URL, used for Stripe redirects and email links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database (Postgres via the Neon serverless driver) ───────────────────────
# Pooled URL used by the app at runtime
DATABASE_URL=
# Direct (non-pooled) URL used by `prisma migrate`; falls back to DATABASE_URL
DIRECT_URL=

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook pointed at /api/webhooks/clerk
# (events: user.created, user.updated, user.deleted)
CLERK_WEBHOOK_SECRET=

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Enables the upgrade button in settings
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PREMIUM_PRICE_ID=
# Signing secret of the Stripe webhook pointed at /api/stripe/webhook
# (events: customer.subscription.created/updated/deleted/paused/resumed)
STRIPE_WEBHOOK_SECRET=

# ─── Premium AI meal plans (optional) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Email: weekly reminder cron (Resend) ─────────────────────────────────────
AUTH_RESEND_KEY=
# Must be a sender on a domain verified in Resend, e.g. "Plate <hello@yourdomain>"
RESEND_FROM_EMAIL=
# Vercel sends this as a Bearer token to /api/cron/*; the cron is closed if unset
CRON_SECRET=
# Signs unsubscribe links (falls back to CRON_SECRET). Rotating it invalidates old links.
UNSUBSCRIBE_SECRET=

# ─── Rate limiting & caching (Upstash Redis, optional) ────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Product analytics (PostHog, optional) ────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Recipe vector index (Pinecone, optional; used by scripts/index-recipes-pinecone.ts) ─
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
